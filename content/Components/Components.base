filters:
  and:
    - file.ext == "md"
    - file.inFolder("Components")
    - class == "component"
views:
  - type: cards
    name: Cards
    groupBy:
      property: acquisition
      direction: DESC
    order:
      - file.name
      - acquisition
    sort:
      - property: file.name
        direction: ASC
    image: image
    cardSize: 150
    imageAspectRatio: 1
